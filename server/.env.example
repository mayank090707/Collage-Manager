# Server environment variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.

# ─── MongoDB Atlas (REQUIRED) ─────────────────────────────────────────────────
# Get this from: Atlas Dashboard → Clusters → Connect → Drivers
# Replace <username>, <password>, and <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campushub?retryWrites=true&w=majority

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Admin Key ────────────────────────────────────────────────────────────────
# This key is required in the X-Admin-Key header to call admin API endpoints.
# Change this to something secret in production.
ADMIN_KEY=AdminPassword123
